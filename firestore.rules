rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isTeacher() {
      return isSignedIn() && role() == 'teacher';
    }

    function isStaff() {
      return isSignedIn() && role() == 'staff';
    }

    function isStaffOrTeacher() {
      return isTeacher() || isStaff();
    }

    function isPortalUser() {
      return isAdmin() || isTeacher() || isStaff();
    }

    // ─── Public portfolio content ────────────────────────────
    // Portfolio pages fetch these unauthenticated. Only admins may write.

    match /faculty/{facultyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /galleryItems/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // One doc per portfolio page: home, about, academics, admissions, contact.
    match /siteContent/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────

    // Users — profile records for authenticated portal users.
    // All signed-in portal staff need to see each other's names for assignments.
    match /users/{uid} {
      allow read: if isPortalUser();
      allow create, update, delete: if isAdmin();
    }

    // Classes — admin-managed.
    match /classes/{classId} {
      allow read: if isPortalUser();
      allow create, update, delete: if isAdmin();
    }

    // Students — admin creates/edits/promotes; teachers and staff can read.
    match /students/{studentId} {
      allow read: if isPortalUser();
      allow create, update, delete: if isAdmin();
    }

    // Subjects — teacher and staff can add; admin can do anything.
    match /subjects/{subjectId} {
      allow read: if isPortalUser();
      allow create: if isStaffOrTeacher() || isAdmin();
      allow update, delete: if isAdmin()
        || (isStaffOrTeacher() && resource.data.teacherId == request.auth.uid);
    }

    // Attendance — one register per class per day ({classId}_{date}). Saved only
    // through the saveAttendance function, which allows a class's class teacher
    // (or an admin), limits teachers to recent days, and updates the students'
    // attendanceSummary docs and parents' phones in the same step.
    match /attendance/{attendanceId} {
      allow read: if isPortalUser();
      allow write: if false;
    }

    // Results — staff and teachers upload; only uploader or admin can edit.
    match /results/{resultId} {
      allow read: if isPortalUser();
      allow create: if isStaffOrTeacher() || isAdmin();
      allow update, delete: if isAdmin()
        || (isStaffOrTeacher() && resource.data.uploadedBy == request.auth.uid);
    }

    // Syllabus — teacher uploads; admin can moderate.
    match /syllabus/{syllabusId} {
      allow read: if isPortalUser();
      allow create: if isTeacher() || isAdmin();
      allow update, delete: if isAdmin()
        || (isTeacher() && resource.data.uploadedBy == request.auth.uid);
    }

    // Messages from the website's contact form. Created only by the
    // submitContactMessage function (it validates and rate-limits); admins read
    // them, mark them read / unread, and delete them.
    match /contactMessages/{messageId} {
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow create: if false;
    }

    // Counters — counters/studentCode numbers new students' Student IDs.
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // parentDevices, parentLoginAttempts, parentFeeds (the parent app),
    // attendanceSummary and contactRateLimits are only touched by Cloud Functions,
    // so they fall through to the deny below.

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
